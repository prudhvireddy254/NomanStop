# ── auth-service (.env) ──────────────────────────────────────────────────────
# cp env.example auth-service/.env

DATABASE_URL=postgresql://nomanstop:nomanstop@localhost:5432/nomanstop
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=60m

# ── api-gateway (.env) ─────────────────────────────────────────────────────────
# cp env.example api-gateway/.env
# (gateway only needs JWT_SECRET + optional AUTH_SERVICE_* below)

JWT_SECRET=dev-jwt-secret-change-in-production

# Local dev without Docker — point gateway at auth-service on your machine
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4000
